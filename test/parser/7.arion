program Kasus2;

var
  i, batas, level: Integer;
  pilihan: Char;

begin
  batas := 5;
  
  for i := 1 to batas do
  begin
    if (i mod 2 == 0) then
      writeln('Genap')
    else
      writeln('Ganjil');
  end;

  while i < 10 do 
  begin
    i := i + 1;
  end;

  repeat
    batas := batas - 1;
  until batas == 0;

  case pilihan of
    'A': level := 100;
    'B': level := 50;
    'C': level := 10
  end;

  ;
end.