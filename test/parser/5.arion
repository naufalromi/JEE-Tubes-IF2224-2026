program ParseFive;
const
    MaxVal = 100;
    LabelText = 'ready';
type
    Level = (Low, Medium, High);
    Score = 1..10;
    Table = array [1..3] of Integer;
    Pair = record
        left, right: Integer;
        mark: Integer
    end;
var
    a, b: Integer;
begin
    a := MaxVal;
    b := (a div 10) + 7;
    writeln(LabelText);
    writeln(a);
    writeln(b)
end.
