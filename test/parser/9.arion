program Kasus4;

var
  hasil: Integer;

procedure Tukar(a, b: Integer; mode: Char);
var 
  temp: Integer;
begin
  if mode == 'X' then
    temp := a
end;

function Faktorial(n: Integer): Integer;
begin
  if n <= 1 then
    Faktorial := 1
  else
    Faktorial := n * Faktorial(n - 1);
end;

begin
  Tukar(10, 20, 'X');
  hasil := Faktorial(5);
end.