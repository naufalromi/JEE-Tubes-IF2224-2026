program Kasus3;

type
  Hari == (Senin, Selasa, Rabu, Kamis, Jumat);
  NilaiUjian == 0..100;
  
  Siswa == record
    nama: String;
    umur: Integer;
    nilai: array [1..5] of NilaiUjian
  end;

var
  kelas: array [1..30] of Siswa;
  hariIni: Hari;

begin
  hariIni := Senin;
  kelas[1].nama := 'Budi';
  kelas[1].umur := 16;
  kelas[1].nilai[1] := 85;
  kelas[1].nilai[2] := 90
end.