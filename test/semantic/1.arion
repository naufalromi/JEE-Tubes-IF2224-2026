program StressArion;

const
  SIZE == 4;
  LIMIT == 7;
  TITLE == '=== ARION STRESS TEST ===';

type
  Row == array [0..SIZE] of Integer;
  Matrix == array [0..SIZE] of Row;

var
  grid, copy: Matrix;
  i, j, diagonal, border, checksum, countdown: Integer;

function modn(a, b: Integer): Integer;
begin
  modn := (a mod b + b) mod b;
end;

function square(x: Integer): Integer;
begin
  square := x * x;
end;

function weighted(a, b, c: Integer): Integer;
var
  temp: Integer;
begin
  temp := square(a) + b * 3 - c;
  if temp < 0 then
    weighted := 0
  else
    weighted := temp;
end;

procedure fill(var m: Matrix);
var
  y, x, value: Integer;
begin
  for y := 0 to SIZE do
  begin
    for x := 0 to SIZE do
    begin
      value := weighted(y, x, modn(y - x, 3));
      if (x == y) then
        m[y][x] := value + 100
      else
        m[y][x] := value;
    end;
  end;
end;

procedure copyAndMutate(var dst, src: Matrix);
var
  y, x, n: Integer;
begin
  for y := 0 to SIZE do
  begin
    for x := 0 to SIZE do
    begin
      n := src[y][x];
      if (y == 0) or (x == 0) or (y == SIZE) or (x == SIZE) then
        dst[y][x] := n + 1
      else
        dst[y][x] := n - 1;
    end;
  end;
end;

function sumDiagonal(var m: Matrix): Integer;
var
  k, total: Integer;
begin
  total := 0;
  for k := 0 to SIZE do
  begin
    total := total + m[k][k];
  end;
  sumDiagonal := total;
end;

function sumBorder(var m: Matrix): Integer;
var
  y, x, total: Integer;
begin
  total := 0;
  for y := 0 to SIZE do
  begin
    for x := 0 to SIZE do
    begin
      if (y == 0) or (x == 0) or (y == SIZE) or (x == SIZE) then
        total := total + m[y][x];
    end;
  end;
  sumBorder := total;
end;

procedure printMatrix(var m: Matrix);
var
  y, x: Integer;
begin
  for y := 0 to SIZE do
  begin
    write(y);
    write(':');
    for x := 0 to SIZE do
    begin
      write(' ');
      write(m[y][x]);
    end;
    writeln('');
  end;
end;

begin
  writeln(TITLE);

  fill(grid);
  writeln('Original matrix');
  printMatrix(grid);

  copyAndMutate(copy, grid);
  writeln('Mutated copy');
  printMatrix(copy);

  diagonal := sumDiagonal(copy);
  border := sumBorder(copy);
  checksum := diagonal + border;

  writeln('Diagonal');
  writeln(diagonal);
  writeln('Border');
  writeln(border);
  writeln('Checksum');
  writeln(checksum);

  case modn(checksum, 4) of
    0: writeln('Case zero');
    1: writeln('Case one');
    2: writeln('Case two');
    3: writeln('Case three')
  end;

  countdown := 3;
  repeat
    write('repeat ');
    writeln(countdown);
    countdown := countdown - 1;
  until countdown == 0;

  while countdown < 3 do
  begin
    write('while ');
    writeln(countdown);
    countdown := countdown + 1;
  end;

  if (checksum > 0) and (diagonal > 0) then
    writeln('PASS')
  else
    writeln('FAIL');
end.
