program GameOfLife;

const
    ROWS == 16;
    COLS == 32;

type 
    { membuat element matrix }
    arrmatrix == array [0..COLS] of Integer;
    { membuat matrix}
    Tmatrix == array [0..ROWS] of arrmatrix;

var 
    front: Tmatrix;
    back: Tmatrix;
    k,x,y : Integer;

procedure display(var matrix : Tmatrix);
    var 
        y, x : Integer;

    begin
        for y := 0 to (ROWS - 1) do
            begin   
                for x := 0 to (COLS - 1) do
                begin
                    if (matrix[y][x] == 1) then
                        write('#')
                    else 
                        write('.');
                end;
                writeln('');
            end;
    end;



function modn(a,b : Integer) : Integer;
    begin
        modn := ((a MOD b) + b) MOD b;
    end;

function countnbor(cx, cy : Integer; var matrix : Tmatrix) : Integer;
    var 
        nbors,dx,dy,x,y : Integer;
    begin
        nbors := 0;
        for dx := -1 to 1 do
        begin
            for dy := -1 to 1 do
            begin
                if ((dx <> 0) OR (dy <> 0)) then
                begin
                    x := modn(cx + dx, COLS);
                    y := modn(cy + dy, ROWS);
                    if (matrix[y][x] == 1) then
                        nbors := nbors + 1;
                end;
            end;
        end;
        countnbor := nbors;
    end;
        
procedure next(var front,back : Tmatrix);
    var 
        nbors : Integer;
        y,x : Integer;
    
    begin
        for y := 0 to (ROWS - 1) do
            begin
                for x := 0 to (COLS - 1 )do
                begin
                    nbors := countnbor(x, y, front); 
                    if (front[y][x] == 1) then
                    begin
                        if ((nbors == 2) OR (nbors == 3) ) then
                            back[y][x] :=  1
                        else 
                            back[y][x] := 0;
                    end
                    else
                    begin
                        if (nbors == 3) then
                            back[y][x] := 1
                        else 
                             back[y][x] := 0;
                    end;
                end;
            end;
    end;

procedure copyMatrix(var dest, src : Tmatrix);
    var
        y, x : Integer;
    begin
        for y := 0 to (ROWS - 1 )do
            begin
                for x := 0 to (COLS - 1) do
                begin
                    dest[y][x] := src[y][x];
                end;
            end;
    end;



begin
    for y := 0 to ROWS - 1 do
    begin
        for x := 0 to COLS - 1 do
            begin
            front[y][x] := 0;
            end;
        end;

    {   012 }
    { 0 .*. }
    { 1 ..* }
    { 2 *** }

    front[0][1] := 1;
    front[1][2] := 1;
    front[2][0] := 1;
    front[2][1] := 1;
    front[2][2] := 1;

    writeln('--- Generasi Awal ---');
    while (True) do 
        begin
        display(front);
        next(front,back);
        copyMatrix(front, back) ;

        for k := 0 to 6767 do
            begin
            end;
        writeln('');

    end;

end.
